# ─── 0G Chain ────────────────────────────────────────────
# Private key for deploying contracts (DO NOT commit!)
PRIVATE_KEY=your_private_key_here

# 0G Galileo Testnet RPC
ZG_TESTNET_RPC=https://evmrpc-testnet.0g.ai

# ─── 0G Compute Router ──────────────────────────────────
# Get your API key from https://pc.testnet.0g.ai
ZG_COMPUTE_API_KEY=your_0g_compute_api_key_here
ZG_COMPUTE_BASE_URL=https://router-api-testnet.integratenetwork.work/v1

# ─── 0G Storage ─────────────────────────────────────────
ZG_STORAGE_RPC=https://storage-testnet.0g.ai

# ─── Contract Addresses (filled after deployment) ───────
NEXT_PUBLIC_SENTINEL_REGISTRY=
NEXT_PUBLIC_PROTOCOL_GUARD=
NEXT_PUBLIC_VULNERABLE_VAULT=

# ─── Network Config ─────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=16602
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_EXPLORER_URL=https://chainscan-galileo.0g.ai

# ─── RainbowKit / Reown ─────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_ID=your_reown_project_id_here
